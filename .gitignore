icx.sqlite3-shm
install.key

# `icx install` leaves backups beside each edited agent config, and a temporary file if a
# write is interrupted; neither belongs in a repository that holds project-level configs.
*.icx-backup-*
.*.icx-tmp-*

# Plugin test tooling (integrations/opencode runs with Bun; no package manifest is committed)
node_modules/
bun.lock
bun.lockb

# Antigravity PR reviewer: large-diff on-disk handoff (transient, removed by the script).
/.agy-review-work/

# Local patent drafts are never published (v1.1.0, ICX-AUD-038).
/patents/

# Playwright MCP session output (screenshots, snapshots)
.playwright-mcp/
.ruff_cache/

# Local agent and environment files (never committed)
.claude/settings.local.json
CLAUDE.local.md
.env
.env.*
.envrc
.direnv/

# Documentation site staging and output (scripts/build_docs_site.py, Zensical)
/.site-src/
/.site-cache/
/site/

# Local archives of files no longer needed in the repository (kept on disk only)
archive/

# Reverse-engineering output: never published (owner policy, 2026-11-22). Decompiled or
# disassembled code, REA evidence bundles and snapshots, analysis databases and string dumps
# of agent builds stay on disk only. Public docs carry interoperability conclusions only.
ref-docs/agent-internals/private/
**/rea-evidence/
**/rea-output/
**/.rea/
*.rea.json
*.rea-snapshot
*-evidence-bundle.json
